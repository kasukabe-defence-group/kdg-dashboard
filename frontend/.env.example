# Public browser configuration: NEVER put credentials or service secrets here.
# Empty means same-origin /api/v1, using the development proxy or production proxy.
VITE_KDG_API_URL=
VITE_KDG_USE_MOCKS=false
# Server-side setting: also export this in the Node process environment.
KDG_API_INTERNAL_URL=http://127.0.0.1:8000
