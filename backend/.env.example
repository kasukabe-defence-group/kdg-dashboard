# Local Linux development only. Real .env files and .state data must stay private.
# Load these values into the API process environment; the app does not load .env.
KDG_STATE_DIR=./.state
KDG_AUTH_USERS_FILE=./.state/users.json
KDG_API_KEYS_FILE=./.state/api-keys.json
KDG_AUDIT_FILE=./.state/audit.jsonl
KDG_NC_SSO_MAP_FILE=./.state/nextcloud-sso-map.json
KDG_DRIVE_CACHE_DIR=./.state/previews
KDG_S3_ROOT=./.state/object-storage
KDG_MINECRAFT_ROOT=./.state/minecraft
KDG_WORKSPACE_ROOT=./.state/workspaces

# Set true in production behind HTTPS. False is ONLY for local HTTP development.
KDG_AUTH_COOKIE_SECURE=false
KDG_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional services. Configure your own existing services; no credentials included.
# Docker proxy must remain read-only and must not be exposed to the internet.
KDG_DOCKER_PROXY=http://127.0.0.1:2376
NEXTCLOUD_INTERNAL_URL=http://127.0.0.1:8080
NEXTCLOUD_PUBLIC_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_TIMEOUT=30
NEXTCLOUD_MAX_UPLOAD_BYTES=5368709120
